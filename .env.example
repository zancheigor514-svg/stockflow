# Apenas para desenvolvimento local. Troque por uma senha exclusiva antes de guardar dados reais.
POSTGRES_DB=stockflow
POSTGRES_USER=stockflow
POSTGRES_PASSWORD=stockflow_dev_2026
POSTGRES_PORT=5433

# Na primeira inicialização, configure uma conta única do responsável da loja.
STOCKFLOW_ADMIN_USERNAME=admin
STOCKFLOW_ADMIN_PASSWORD=

# Desenvolvimento local. Em produção, use HTTPS e mude AUTH_COOKIE_SECURE para true.
APP_ENV=development
AUTH_COOKIE_SECURE=false
FRONTEND_ORIGINS=http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1

# Backup automático diário, mantendo até 30 dias localmente.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
