# Copie para .env.production no servidor. Nunca envie esse arquivo ao Git.
# Aponte o DNS A do domínio para o IP público do servidor antes de iniciar.
DOMAIN=estoque.seudominio.com.br

POSTGRES_DB=stockflow
POSTGRES_USER=stockflow
# Use somente letras, números, _ ou - para evitar caracteres especiais na URL.
POSTGRES_PASSWORD=COLOQUE_UM_SEGREDO_LONGO_AQUI

STOCKFLOW_ADMIN_USERNAME=admin
STOCKFLOW_ADMIN_PASSWORD=COLOQUE_UMA_SENHA_UNICA_DE_14_CARACTERES_OU_MAIS

BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
